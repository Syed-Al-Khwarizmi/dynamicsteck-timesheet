{
  "name": "DynamicsTeck Timesheet",

  // A prebuilt image from Microsoft, pulled from cache in seconds.
  //
  // Deliberately no "features" block: any feature turns codespace creation into
  // a Docker build instead of a cached pull, which costs minutes. Everything
  // this project needs is already in this image.
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",

  // Roughly ten seconds. The Turso CLI is not installed here because it is
  // needed once, at deploy time, and downloading it on every codespace create
  // would slow down every start. See .devcontainer/README.md for the one-liner.
  "postCreateCommand": "npm install",

  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": { "label": "Timesheet", "onAutoForward": "openPreview" }
  }
}
