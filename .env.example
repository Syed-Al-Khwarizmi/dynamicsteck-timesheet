# Local development needs none of this - leave the file absent and the app uses
# data/timesheet.db on disk.
#
# For hosting, set both in your platform's dashboard (Render: Environment;
# Koyeb: Environment variables). Never commit the token.
TURSO_DATABASE_URL=libsql://your-database-name-yourorg.turso.io
TURSO_AUTH_TOKEN=
# PORT is set by the host automatically; only override it locally.
# PORT=3000
